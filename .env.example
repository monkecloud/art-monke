# Copy to .env for local development. .env is gitignored — never commit real values.
#
# These are for running the app on your own machine against your own local services.
# In the cluster the same variables are injected from Kubernetes Secrets, so nothing here
# is used by a deploy.

DATABASE_URL=postgresql://localhost:5432/monke-app_dev
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=monke-app-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
# The cache this repo runs (k8s/redis.yaml). Used for transcode progress by both the api and
# the worker. In the cluster they get REDIS_PASSWORD instead and the host/port are constants
# in the code; locally this one URL overrides that, so it can point at your own Redis.
REDIS_URL=redis://default:PASSWORD@localhost:6379/0

# apps/worker additionally needs `ffmpeg` and `ffprobe` on PATH. Its images install them; a
# local run uses whatever your machine has. It writes scratch files to /tmp/scratch.
