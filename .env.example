# Copy to .env for local development. .env is gitignored — never commit real values.
#
# These are for running the app on your own machine against your own local services.
# In the cluster the same variables are injected from Kubernetes Secrets, so nothing here
# is used by a deploy.

DATABASE_URL=postgresql://localhost:5432/monke-app_dev
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=monke-app-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Only if this repo runs a cache (k8s/redis.yaml).
REDIS_URL=redis://default:PASSWORD@localhost:6379/0
